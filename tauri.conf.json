{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roblox Account Manager",
  "version": "4.1.17",
  "identifier": "com.gugas19.robloxaccountmanager",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Roblox Account Manager",
        "width": 1120,
        "height": 700,
        "minWidth": 900,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#14161c",
        "center": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*.rbxcdn.com https://*.roblox.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}

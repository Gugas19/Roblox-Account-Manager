<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{5B0E7D2A-2C55-4D7B-9E3A-6F3E5C0B9A11}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>RAM.UnitTests</RootNamespace>
    <AssemblyName>RAM.UnitTests</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\</OutputPath>
    <LangVersion>8.0</LangVersion>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <!-- the tests run against the app that was built, build it first -->
    <AppBuildDir>$(MSBuildThisFileDirectory)..\..\RBX Alt Manager\bin\x64\Release\</AppBuildDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="RobloxAccountManager">
      <HintPath>$(AppBuildDir)RobloxAccountManager.exe</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- lets the project build without the .NET Framework 4.7.2 developer pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- native libsodium used by the encryption tests -->
    <None Include="$(AppBuildDir)libsodium*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
